    classDef coreg fill:#eef7ee,stroke:#3f8a4a,color:#111
    classDef facility fill:#fdf3e3,stroke:#b07a1e,color:#111
    classDef cli fill:#f3eefa,stroke:#6c4ea0,color:#111
    classDef out fill:#f4f4f4,stroke:#555,color:#111
    classDef conv fill:#ffffff,stroke:#111,stroke-width:2px,color:#111
    class CMEG,JSON,CHAN,HELM,SESS,NAME cerca
    class XFM,DIG coreg
    class PERI facility
    class CLI cli
    class DATA,INFO,FIXED,LOG out
    class CONV conv
